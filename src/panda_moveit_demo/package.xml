<?xml version="1.0"?>
<package format="2">
  <name>panda_moveit_demo</name>
  <version>1.0.0</version>
  <description>
    RAPTAR motion planning: collision-aware hemispherical scanning with a
    Franka Emika Panda arm (MoveIt, ROS Noetic) for automated radar
    radiation-pattern acquisition.
  </description>

  <maintainer email="maazqureshi919@gmail.com">Maaz Qureshi</maintainer>
  <license>MIT</license>

  <url type="repository">https://github.com/Maaz-qureshi98/RAPTAR-Motion-Planning</url>
  <url type="website">https://arxiv.org/abs/2507.16988</url>
  <author>Maaz Qureshi</author>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>moveit_commander</depend>
  <depend>rospy</depend>

  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>eigenpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
  </export>
</package>
